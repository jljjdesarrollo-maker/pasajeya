{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/v1/cron/backup-db",
      "schedule": "50 23 * * *"
    },
    {
      "path": "/api/v1/cron/liquidacion-dia1",
      "schedule": "5 0 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}

